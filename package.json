{
  "name": "deplomot",
  "version": "1.0.0",
  "description": "Paste your code. Get a working website.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder build --win",
    "build:dir": "electron-builder build --win --dir"
  },
  "author": "Deplomot",
  "license": "MIT",
  "build": {
    "appId": "com.deplomot.app",
    "productName": "Deplomot",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "utils/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ]
  },
  "dependencies": {
    "archiver": "^6.0.2",
    "node-fetch": "^2.7.0",
    "tree-kill": "^1.2.2"
  },
  "devDependencies": {
    "electron": "^28.1.0",
    "electron-builder": "^25.1.8"
  }
}
